generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model lead {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  firstName   String
  lastName    String
  email       String
  jobTitle    String?
  countryCode String?
  companyName String?
  message     String?
  emailVerified Boolean?
  phoneNumber    String?
  yearsAtCompany Int?
  linkedinUrl    String?
  // Phone enrichment: PENDING | RUNNING | FOUND | NOT_FOUND | FAILED
  phoneEnrichmentStatus   String?
  // Provider being queried while RUNNING, or the one that found the phone when FOUND
  phoneEnrichmentProvider String?
  phoneEnrichedAt         DateTime?
}
